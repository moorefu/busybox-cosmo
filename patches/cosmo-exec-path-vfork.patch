+extern char *__program_executable_name;
+const char *get_busybox_exec_path(void)
+{
+	static char bb_busybox_exec_path_buf[PATH_MAX];
+
+	if (!bb_busybox_exec_path_buf[0]) {
+		const char *p = __program_executable_name;
+		if (!p || !p[0])
+			p = bb_argv0 ? bb_argv0 : CONFIG_BUSYBOX_EXEC_PATH;
+		if (!realpath(p, bb_busybox_exec_path_buf)) {
+			/* realpath 失败: 退化为原样路径 */
+			safe_strncpy(bb_busybox_exec_path_buf, p,
+				     sizeof(bb_busybox_exec_path_buf));
+		}
+	}
+	return bb_busybox_exec_path_buf;
+}
