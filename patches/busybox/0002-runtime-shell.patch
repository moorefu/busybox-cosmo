diff --git a/libbb/messages.c b/libbb/messages.c
--- a/libbb/messages.c
+++ b/libbb/messages.c
@@ -27,7 +27,45 @@
 
 const char bb_hexdigits_upcase[] ALIGN1 = "0123456789ABCDEF";
 
+#if !defined(__COSMOPOLITAN__)
 const char bb_busybox_exec_path[] ALIGN1 = CONFIG_BUSYBOX_EXEC_PATH;
+#else
+/* cosmo 版: 自身路径运行时解析
+ * argv[0] 在多层 exec 后不可靠(exec 后 argv[0]=applet 名), 用 cosmo 运行时
+ * 在 APE 启动时填充的 __program_executable_name(绝对路径)。 */
+#include <limits.h>
+extern char *__program_executable_name;
+extern char *GetProgramExecutableName(void);
+const char *get_busybox_exec_path(void)
+{
+	static char bb_busybox_exec_path_buf[PATH_MAX];
+
+	if (!bb_busybox_exec_path_buf[0]) {
+		const char *p = NULL;
+		/* 1) cosmo 惰性解析 GetProgramExecutableName() 优先: mac 上它会走
+		 *    KERN_PROCARGS2, loader ('-') 形态下解析出 loader argv 里的
+		 *    载荷真实路径 (loader - PROG ARGV0.. → PROG) —— 任意嵌套深度
+		 *    都成立 (2026-09-04 mac loader STANDALONE 自 exec 修复)。
+		 * 2) 其次 argv[0] (首层启动 argv[0]=busybox 路径)。
+		 * 3) 再回落启动期 __program_executable_name (loader 形态下为
+		 *    loader 自身路径, 仅作最后兜底) / CONFIG 默认。 */
+		p = GetProgramExecutableName();
+		if (p && p[0] && realpath(p, bb_busybox_exec_path_buf))
+			return bb_busybox_exec_path_buf;
+		if (bb_argv0 && realpath(bb_argv0, bb_busybox_exec_path_buf))
+			return bb_busybox_exec_path_buf;
+		p = __program_executable_name;
+		if (!p || !p[0])
+			p = CONFIG_BUSYBOX_EXEC_PATH;
+		if (!realpath(p, bb_busybox_exec_path_buf)) {
+			/* realpath 失败: 退化为原样路径 */
+			safe_strncpy(bb_busybox_exec_path_buf, p,
+				     sizeof(bb_busybox_exec_path_buf));
+		}
+	}
+	return bb_busybox_exec_path_buf;
+}
+#endif
 const char bb_default_login_shell[] ALIGN1 = LIBBB_DEFAULT_LOGIN_SHELL;
 /* util-linux manpage says /sbin:/bin:/usr/sbin:/usr/bin,
  * but I want to save a few bytes here. Check libbb.h before changing! */
diff --git a/shell/ash.c b/shell/ash.c
--- a/shell/ash.c
+++ b/shell/ash.c
@@ -6105,6 +6105,53 @@
 }
 
 
+#if defined(__COSMOPOLITAN__)
+#include <alloca.h>
+/* APE 文件(cosmo)在无 binfmt 平台: exec ENOEXEC 后交 ape loader。
+ * loader argv 需 [ape, cmd路径, 原argv0, 原argv1...]——ash 的"当脚本"
+ * fallback 会丢 argv0(applet 名), loader 路径完整保留。 */
+static void exec_ape_via_loader(const char *cmd, char **argv, char **envp)
+{
+	char apepath[PATH_MAX];
+	const char *apeloader = NULL;
+	int afd = open(cmd, O_RDONLY);
+	char amagic[8];
+	bool isape = false;
+	if (afd >= 0) {
+		if (full_read(afd, amagic, 8) == 8)
+			isape = (memcmp(amagic, "MZqFpD='", 8) == 0);
+		close(afd);
+	}
+	if (!isape)
+		return;
+	{
+		const char *home = getenv("HOME");
+		if (home) {
+			snprintf(apepath, sizeof(apepath), "%s/.ape-1.10", home);
+			if (access(apepath, X_OK) == 0) apeloader = apepath;
+		}
+	}
+	if (!apeloader && access("/usr/local/bin/ape", X_OK) == 0)
+		apeloader = "/usr/local/bin/ape";
+	if (!apeloader && access("/usr/bin/ape", X_OK) == 0)
+		apeloader = "/usr/bin/ape";
+	if (apeloader) {
+		int ni = 0, ai, argc = 0;
+		char **nargv;
+		while (argv[argc]) argc++;
+		/* 该函数可能运行在 vfork 子进程；使用子栈上的可变数组，不调用
+		 * malloc，也不再把参数静默截断到 63 项。 */
+		nargv = alloca((argc + 3) * sizeof(*nargv));
+		nargv[ni++] = (char *)apeloader;
+		nargv[ni++] = (char *)cmd;
+		for (ai = 0; argv[ai]; ai++)
+			nargv[ni++] = argv[ai];
+		nargv[ni] = NULL;
+		execve(apeloader, nargv, envp);
+	}
+}
+#endif
+
 /*
  * execve wrappers
  */
@@ -6164,6 +6211,11 @@
 	}
 	/* re-exec ourselves with the new arguments */
 	execve(bb_busybox_exec_path, argv, envp);
+#if defined(__COSMOPOLITAN__)
+	/* exec 自身(APE)在无 binfmt 平台 ENOEXEC——交 ape loader */
+	if (errno == ENOEXEC)
+		exec_ape_via_loader(bb_busybox_exec_path, argv, envp);
+#endif
 	/* If they called chroot or otherwise made the binary
 	 * no longer executable, return.
 	 */
@@ -6182,6 +6234,11 @@
