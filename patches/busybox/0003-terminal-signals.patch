diff --git a/libbb/u_signal_names.c b/libbb/u_signal_names.c
--- a/libbb/u_signal_names.c
+++ b/libbb/u_signal_names.c
@@ -26,6 +26,46 @@
 //config:	This behavior matches "kill -l RTMIN+n" from bash.
 
 #include "libbb.h"
+#if defined(__COSMOPOLITAN__)
+/* cosmocc (4.0.2) binds these signals as extern const with per-OS values;
+ * designated initializers require compile-time constants.  Upstream cosmo
+ * master unifies signal numbers (Linux layout) - pin to those. */
+#undef SIGBUS
+#undef SIGCHLD
+#undef SIGCONT
+#undef SIGIO
+#undef SIGPOLL
+#undef SIGPWR
+#undef SIGRTMIN
+#undef SIGRTMAX
+#undef SIGSTKFLT
+#undef SIGSTOP
+#undef SIGSYS
+#undef SIGTSTP
+#undef SIGTTIN
+#undef SIGTTOU
+#undef SIGURG
+#undef SIGUSR1
+#undef SIGUSR2
+#define SIGBUS 7
+#define SIGCHLD 17
+#define SIGCONT 18
+#define SIGIO 29
+#define SIGPOLL 29
+#define SIGPWR 30
+#define SIGRTMIN 34
+#define SIGRTMAX 64
+#define SIGSTKFLT 16
+#define SIGSTOP 19
+#define SIGSYS 31
+#define SIGTSTP 20
+#define SIGTTIN 21
+#define SIGTTOU 22
+#define SIGURG 23
+#define SIGUSR1 10
+#define SIGUSR2 12
+#endif
+
 
 /* Believe it or not, but some arches have more than 32 SIGs!
  * HPPA: SIGSTKFLT == 36. */
