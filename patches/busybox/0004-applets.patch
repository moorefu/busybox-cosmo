diff --git a/coreutils/whoami.c b/coreutils/whoami.c
--- a/coreutils/whoami.c
+++ b/coreutils/whoami.c
@@ -29,11 +29,29 @@
 int whoami_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
 int whoami_main(int argc UNUSED_PARAM, char **argv UNUSED_PARAM)
 {
+	const char *name;
+
 	if (argv[1])
 		bb_show_usage();
 
 	/* Will complain and die if username not found */
+#if defined(__COSMOPOLITAN__)
+	/* BusyBox 的内置 passwd 解析器只读 /etc/passwd；macOS 目录服务和
+	 * Windows 账户并不保证出现在该文件。先保持 Unix uid 查询语义，再
+	 * 使用 Cosmopolitan 在 BSD/Windows 上连接系统账户 API 的 getlogin。 */
+	name = uid2uname(geteuid());
+	if (!name || !name[0])
+		name = getlogin();
+	if ((!name || !name[0]) && getenv("USER"))
+		name = getenv("USER");
+	if ((!name || !name[0]) && getenv("USERNAME"))
+		name = getenv("USERNAME");
+	if (!name || !name[0])
+		bb_error_msg_and_die("unknown uid %u", (unsigned)geteuid());
+	puts(name);
+#else
 	puts(xuid2uname(geteuid()));
+#endif
 
 	return fflush_all();
 }
