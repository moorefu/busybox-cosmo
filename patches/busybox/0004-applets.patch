+#if defined(__COSMOPOLITAN__)
+/* cosmo/Windows: 无 /proc。用 Win32 Toolhelp 枚举系统进程。
+ * cosmo libc 暴露 NT API(libc/nt/*), 本分支不依赖 /proc。 */
+#include <libc/nt/process.h>
+#include <libc/nt/enum/th32cs.h>
+#include <libc/nt/runtime.h>
+#include <libc/str/str.h>
+/* 使用工具链真实声明，避免手写 void* 原型造成 ABI 不匹配。 */
+extern axdx_t tprecode16to8(char *, size_t, const char16_t *) libcesque;
+/* cosmo 运行时宿主 OS 位掩码(_HOSTWINDOWS=4), 见 libc/dce.h */
+extern unsigned char __hostos;
+#define COSMO_HOST_WINDOWS 4
+static int cosmo_ps_main(void)
+{
+	int64_t snap;
+	struct NtProcessEntry32 e;
+	char comm8[512];
+
+	snap = CreateToolhelp32Snapshot(kNtTh32csSnapprocess, 0);
+	if (snap == -1)
+		return EXIT_FAILURE;
+	memset(&e, 0, sizeof(e));
+	e.dwSize = sizeof(e);
+	/* 列: PID PPID STAT CMD (Windows 无真实进程状态, STAT 恒 'S') */
+	printf("%7s %7s %-4s %s\n", "PID", "PPID", "STAT", "CMD");
+	if (Process32First(snap, &e)) {
+		do {
+			tprecode16to8(comm8, sizeof(comm8), e.szExeFile);
+			printf("%7lu %7lu %-4s %s\n",
+				(unsigned long)e.th32ProcessID,
+				(unsigned long)e.th32ParentProcessID,
+				"S", comm8);
+		} while (Process32Next(snap, &e));
+	}
+	CloseHandle(snap);
+	return EXIT_SUCCESS;
+}
+#endif
+
