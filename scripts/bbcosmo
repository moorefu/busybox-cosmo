#!/bin/sh
# busybox-cosmo 运行诊断与能力报告入口

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
if [ -f "$SCRIPT_DIR/lib/portable.sh" ]; then
	HERE="$SCRIPT_DIR"
else
	HERE="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
fi
if [ -z "${BBP_BUSYBOX:-}" ]; then
	case "$(uname -s 2>/dev/null)" in
		*[Ww]indows*|*[Ww]in32*) bbcosmo_first="$HERE/busybox.com"; bbcosmo_second="$HERE/busybox" ;;
		*) bbcosmo_first="$HERE/busybox"; bbcosmo_second="$HERE/busybox.com" ;;
	esac
	for bbcosmo_candidate in "$bbcosmo_first" "$bbcosmo_second"; do
		if [ -x "$bbcosmo_candidate" ]; then
			BBP_BUSYBOX=$bbcosmo_candidate
			break
		fi
	done
fi
. "$HERE/lib/portable.sh" || exit 2

usage() {
	cat >&2 <<'EOF'
用法:
  bbcosmo capabilities [--format text|kv|json]
  bbcosmo doctor
  bbcosmo run <busybox 参数...>
环境:
  BBP_BUSYBOX=路径       指定发行包 launcher 或 busybox 二进制
  BBP_XZ_ENCODER=路径    指定可验证的外部 xz 编码器
  BBP_LZMA_ENCODER=路径  指定可验证的外部 lzma 编码器
  BBP_ZIP_ENCODER=路径   指定可验证的外部 zip 编码器
EOF
}

bbcosmo_json_escape() {
	# shell 变量不能保存 NUL；其余 C0 控制字转为 JSON \u00xx，UTF-8 字节原样保留。
	printf '%s' "$1" | bbp awk '
		BEGIN { first = 1 }
		{
			if (!first) printf "\\n"
			first = 0
			for (i = 1; i <= length($0); i++) {
				c = substr($0, i, 1)
				if (c == "\\") printf "\\\\"
				else if (c == "\"") printf "\\\""
				else {
					code = -1
					for (j = 1; j < 32; j++) if (c == sprintf("%c", j)) { code = j; break }
					if (code >= 0) printf "\\u%04x", code
					else printf "%s", c
				}
			}
		}'
}

bbcosmo_emit() {
	bbcosmo_emit_name=$1
	bbcosmo_emit_value=$2
	case "$bbcosmo_format" in
		json)
			[ "$bbcosmo_json_first" = 1 ] || printf ',\n'
			printf '  "%s": "%s"' \
				"$(bbcosmo_json_escape "$bbcosmo_emit_name")" \
				"$(bbcosmo_json_escape "$bbcosmo_emit_value")"
			bbcosmo_json_first=0
			;;
		kv) printf '%s=%s\n' "$bbcosmo_emit_name" "$bbcosmo_emit_value" ;;
		text) printf '%-32s %s\n' "$bbcosmo_emit_name" "$bbcosmo_emit_value" ;;
	esac
}

bbcosmo_capability() {
	bbcosmo_cap_name=$1
	shift
	if "$@" >/dev/null 2>&1; then
		bbcosmo_emit "$bbcosmo_cap_name" available
	else
		bbcosmo_emit "$bbcosmo_cap_name" unavailable
	fi
}

bbcosmo_applet_source() {
	if bbp_have "$2"; then
		bbcosmo_emit "$1" builtin
	else
		bbcosmo_emit "$1" unavailable
	fi
}

bbcosmo_external_operation() {
	bbcosmo_external_name=$1
	bbcosmo_external_probe=$2
	bbcosmo_external_path_fn=$3
	if "$bbcosmo_external_probe" >/dev/null 2>&1; then
		bbcosmo_emit "$bbcosmo_external_name" external
		bbcosmo_external_path=$($bbcosmo_external_path_fn 2>/dev/null || true)
		[ -n "$bbcosmo_external_path" ] || bbcosmo_external_path=unknown
	else
		bbcosmo_emit "$bbcosmo_external_name" unavailable
		bbcosmo_external_path=none
	fi
	bbcosmo_emit "$bbcosmo_external_name.tool" "$bbcosmo_external_path"
}

capabilities() {
	bbcosmo_format=text
	if [ "${1:-}" = --format ]; then
		[ "$#" -ge 2 ] || { printf '%s\n' '--format 缺少值' >&2; return 2; }
		bbcosmo_format=$2
		shift 2
	fi
	[ "$#" -eq 0 ] || { printf '%s\n' 'capabilities 不接受额外参数' >&2; return 2; }
	case "$bbcosmo_format" in
		text|kv) ;;
		json) bbcosmo_json_first=1; printf '{\n' ;;
		*) printf '%s\n' "不支持的格式: $bbcosmo_format" >&2; return 2 ;;
	esac
	bbcosmo_entry_rc=0
	[ "$bbcosmo_format" = text ] && printf '%s\n' '# busybox-cosmo capabilities'
	bbcosmo_emit capabilities.schema 1
	if bbp --list >/dev/null 2>&1; then
		bbcosmo_emit busybox.entry available
	else
		bbcosmo_emit busybox.entry unavailable
		bbcosmo_entry_rc=1
	fi
	bbcosmo_emit platform.os "$(bbp_os)"
	bbcosmo_emit platform.arch "$(bbp_arch)"
	bbcosmo_emit platform.os.family "$(bbp_os_family)"
	bbcosmo_emit platform.arch.family "$(bbp_arch_family)"
	bbcosmo_emit busybox.path "$BBP_BUSYBOX"
	for bbcosmo_applet in sh ash printf test awk sed grep tar gzip gunzip bzip2 bunzip2 xz lzma unlzma unzip stty whoami nproc dnsdomainname pgrep pidof; do
		if bbp_have "$bbcosmo_applet"; then
			bbcosmo_emit "applet.$bbcosmo_applet" available
		else
			bbcosmo_emit "applet.$bbcosmo_applet" unavailable
		fi
	done
	bbcosmo_capability tty.input bbp_is_tty
	bbcosmo_capability tty.size bbp_term_size
	bbcosmo_capability tty.ansi bbp_ansi_available
	bbcosmo_applet_source archive.gzip.encode gzip
	bbcosmo_applet_source archive.gzip.decode gunzip
	bbcosmo_applet_source archive.bzip2.encode bzip2
	bbcosmo_applet_source archive.bzip2.decode bunzip2
	bbcosmo_applet_source archive.xz.decode xz
	bbcosmo_applet_source archive.lzma.decode unlzma
	bbcosmo_applet_source archive.zip.decode unzip
	bbcosmo_external_operation archive.xz.encode bbp_xz_encode_available bbp_external_xz
	bbcosmo_external_operation archive.lzma.encode bbp_lzma_encode_available bbp_external_lzma
	bbcosmo_external_operation archive.zip.encode bbp_zip_encode_available bbp_external_zip
	if bbp_username >/dev/null 2>&1; then
		bbcosmo_emit identity.username available
	else
		bbcosmo_emit identity.username unavailable
	fi
	if bbp_cpu_value=$(bbp_cpu_count 2>/dev/null); then
		bbcosmo_emit system.cpu_count available
		bbcosmo_emit system.cpu_count.value "$bbp_cpu_value"
	else
		bbcosmo_emit system.cpu_count unavailable
		bbcosmo_emit system.cpu_count.value unknown
	fi
	if bbp_dns_domain >/dev/null 2>&1; then
		bbcosmo_emit system.dns_domain available
	else
		bbcosmo_emit system.dns_domain unavailable
	fi
	bbcosmo_capability process.pid_probe bbp_pid_alive "$$"
	if bbp_process_search_available; then
		bbcosmo_emit process.name_search builtin
	else
		bbcosmo_emit process.name_search unsupported
	fi
	bbcosmo_emit network.https.peer_verified unsupported
	bbcosmo_tmp=$(bbp_tmpdir 2>/dev/null || true)
	if [ -n "$bbcosmo_tmp" ] && bbp_cleanup_dir "$bbcosmo_tmp"; then
		bbcosmo_emit filesystem.temp available
	else
		bbcosmo_emit filesystem.temp unavailable
	fi
	[ "$bbcosmo_format" = json ] && printf '\n}\n'
	return "${bbcosmo_entry_rc:-0}"
}

doctor() {
	bbcosmo_fail=0
	printf '%s\n' 'busybox-cosmo 运行诊断'
	printf '入口: %s\n' "$BBP_BUSYBOX"
	if bbp --list >/dev/null 2>&1; then
		printf '%s\n' '入口可执行: 是'
	else
		printf '%s\n' '入口可执行: 否'
		bbcosmo_fail=1
	fi
	if bbp_have sh && bbp_have printf && bbp_have test; then
		printf '%s\n' 'portable-core: 可用'
	else
		printf '%s\n' 'portable-core: 缺少 sh/printf/test'
		bbcosmo_fail=1
	fi
	printf 'UI 模式: %s\n' "$(bbp_ui_mode)"
	if bbp_xz_encode_available; then
		printf '%s\n' 'xz 创建: 可用（已完成编码/解码往返）'
	else
		printf '%s\n' 'xz 创建: 不可用或未配置外部编码器'
	fi
	if bbp_lzma_encode_available; then
		printf '%s\n' 'lzma 创建: 可用（外部编码器已完成往返）'
	else
		printf '%s\n' 'lzma 创建: 不可用或未配置外部编码器'
	fi
	if bbp_zip_encode_available; then
		printf '%s\n' 'zip 创建: 可用（外部编码器已完成往返）'
	else
		printf '%s\n' 'zip 创建: 不可用或未配置外部编码器'
	fi
	if bbp_username >/dev/null 2>&1 && bbp_cpu_count >/dev/null 2>&1; then
		printf '%s\n' '用户/CPU 信息: 可用'
	else
		printf '%s\n' '用户/CPU 信息: 不可用'
		bbcosmo_fail=1
	fi
	if bbp_process_search_available; then
		printf '%s\n' '按名称搜索进程: 可用'
	else
		printf '%s\n' '按名称搜索进程: 不支持；请保存子进程 PID 并使用 kill -0'
	fi
	printf '%s\n' 'HTTPS 对端证书: 不可用（当前内置 TLS 不提供可信校验）'
	printf '%s\n' '提示: 详细平台限制见 KNOWN-LIMITATIONS.md（源码树位于 docs/）'
	return "$bbcosmo_fail"
}

case "${1:-}" in
	capabilities) shift; capabilities "$@" ;;
	doctor) shift; doctor "$@" ;;
	run) shift; [ "$#" -gt 0 ] || { usage; exit 2; }; bbp "$@" ;;
	-h|--help|help) usage ;;
	*) usage; exit 2 ;;
esac
